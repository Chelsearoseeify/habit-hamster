# Turso database (get from: turso db show <name> --url && turso db tokens create <name>)
TURSO_DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
TURSO_AUTH_TOKEN=<your-turso-auth-token>

# Web Push VAPID keys (generate with: npx web-push generate-vapid-keys)
VAPID_EMAIL=your@email.com
VAPID_PUBLIC_KEY=BPxx...
VAPID_PRIVATE_KEY=...

# Exposed to the frontend build
VITE_VAPID_PUBLIC_KEY=BPxx...
# Leave empty in dev (uses Vite proxy to localhost:3000), set in production
VITE_API_URL=

# Cron security — set the same value in cron-job.org request header
# Header: Authorization: Bearer <value>
CRON_SECRET=change-me-to-a-random-secret

# CET=1, CEST=2 (update manually when clocks change, or automate via TZ database)
TIMEZONE_OFFSET_HOURS=1

# Frontend URL for CORS (set in production)
FRONTEND_URL=https://your-app.vercel.app
